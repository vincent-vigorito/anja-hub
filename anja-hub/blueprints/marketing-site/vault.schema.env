# === Vault del brand {BRAND} — livello B (workspace-scoped, gitignored) ===
# Compilare con le credenziali reali del brand. I segreti vivono SOLO qui:
# il .mcp.json del workspace inietta solo il PATH di questo file, mai i valori.

# --- WordPress / WooCommerce (backend wp/woo) ---
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# --- Meta organico (opzionale) ---
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# Meta Ads (se ad-account in business diverso dalla pagina)
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=

# --- SwerpiCommerce (backend swerpi) ---
# La CLI legge da env base_url + bearer; api_id/api_secret servono a generare
# il bearer la prima volta (swerpicommerce-auth token).
SWERPICOMMERCE_BASE_URL=
SWERPICOMMERCE_API_ID=
SWERPICOMMERCE_API_SECRET=
SWERPICOMMERCE_BEARER_AUTH=

# --- Resource-ID Google (puntatori nel connettore agency condiviso) ---
GA4_PROPERTY_ID=
GSC_SITE=
GOOGLE_ADS_CUSTOMER_ID=
MERCHANT_ACCOUNT_ID=
