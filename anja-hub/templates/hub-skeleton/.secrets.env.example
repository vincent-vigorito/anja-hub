# Anja Hub — secrets di livello hub (opzionale)
# Copia in `.secrets.env` nella root del TUO hub (mai committare quel file).
# In alternativa configura tutto dalla UI: Settings → Integrations
# (le chiavi finiscono nel vault cifrato e vengono sincronizzate qui).

# --- LLM providers (chat multi-provider) -----------------------------------
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# --- Generazione immagini/video (CLI giv + Media → Genera) -----------------
# (riusa le stesse chiavi provider qui sopra)
# STABILITY_API_KEY=
# DASHSCOPE_API_KEY=
# IMAGE_DEFAULT_MODEL=nano-banana-3

# --- Research --------------------------------------------------------------
# SERPAPI_KEY=

# --- Telegram bot ----------------------------------------------------------
# (la allow-list dei chat_id si configura dalla UI: Settings → Telegram)
# TELEGRAM_BOT_TOKEN=
